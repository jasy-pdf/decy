{
  "name": "@jasy/decy",
  "version": "0.0.0",
  "description": "Exact decimal math for money and quantities: locale-strict parsing, deliberate rounding, allocation without lost cents. Zero dependencies.",
  "keywords": [
    "allocation",
    "bigint",
    "currency",
    "decimal",
    "format",
    "locale",
    "money",
    "parse",
    "rounding"
  ],
  "homepage": "https://github.com/jasy-pdf/decy#readme",
  "bugs": {
    "url": "https://github.com/jasy-pdf/decy/issues"
  },
  "license": "MIT",
  "author": "Florian Heuberger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasy-pdf/decy.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
